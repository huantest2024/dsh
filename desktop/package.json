{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "1.0.1",
  "description": "DeepSeek Harness 桌面版（Electron）：自托管 dsh web 服务，ZCode 风格深色主题 + 二次元挂件",
  "author": "huantest2024",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 && node scripts/copy-release-notes.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.huantest2024.dsh",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "bar-preload.js",
      "bar.html",
      "update-preload.js",
      "notes.html",
      "splash/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "DSH-Desktop-Windows-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon_app.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "DSH-Desktop-macOS-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "artifactName": "DSH-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.${ext}"
    }
  }
}
