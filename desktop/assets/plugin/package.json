{
  "name": "dsh-anime-theme",
  "description": "二次元主题插件：深色模式下的全屏动漫壁纸 + 半透明玻璃面板 + ZCode 中性深灰调色 + 右下角随机动图挂件（间谍过家家 / Lycoris Recoil）",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
